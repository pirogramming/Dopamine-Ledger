# 이 파일을 복사해서 .env 를 만드세요:  cp .env.example .env

# ── Django ──
# SECRET_KEY 생성: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──
POSTGRES_DB=dopamine
POSTGRES_USER=dopamine
POSTGRES_PASSWORD=dopamine
DATABASE_URL=postgres://dopamine:dopamine@db:5432/dopamine

# ── 카카오 소셜 로그인 (나중에 발급) ──
KAKAO_CLIENT_ID=
KAKAO_SECRET=